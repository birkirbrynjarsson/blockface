{
  "name": "blockface",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal headers-only Bitcoin P2P client serving the most recent block headers over HTTP",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "better-sqlite3": "^13.0.3",
    "bitcore-lib": "^10.10.7",
    "bitcore-p2p": "^10.10.7",
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
