{
  "name": "blockface",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal headers-only Bitcoin P2P client serving the most recent block headers over HTTP",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "bitcore-lib": "^10.10.7",
    "bitcore-p2p": "^10.10.7",
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
